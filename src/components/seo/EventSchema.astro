---
interface Props {
  name: string;
  description?: string;
  startDate: string;
  endDate?: string;
  url?: string;
  locationName?: string;
  locationAddress?: string;
  image?: string;
  organizerName?: string | string[];
  offersUrl?: string;
  performers?: { name: string; type: "Person" | "MusicGroup" }[];
  status?: "EventScheduled" | "EventCancelled" | "EventMovedOnline" | "EventPostponed" | "EventRescheduled";
  attendanceMode?: "OfflineEventAttendanceMode" | "OnlineEventAttendanceMode" | "MixedEventAttendanceMode";
}

const {
  name,
  description,
  startDate,
  endDate,
  url,
  locationName,
  locationAddress,
  image,
  organizerName,
  offersUrl,
  performers = [],
  status = "EventScheduled",
  attendanceMode = "OfflineEventAttendanceMode",
} = Astro.props;

// Helper to filter out "desconocido" and empty values
const cleanValue = (val: any) => {
  if (!val || val === "desconocido") return undefined;
  return val;
};

const formatSchemaDate = (dateStr: string) => {
  if (!dateStr || dateStr === "desconocido") return undefined;
  
  // If it's just a year like "2026", schema requires more. Try to make it first of year if just year.
  if (/^\d{4}$/.test(dateStr)) return `${dateStr}-01-01T00:00:00Z`;

  let cleanStr = dateStr.toLowerCase().trim();
  
  // Match "Lunes 27 de Abril de 2026", "27 de abril de 2026", "24 de Novimienbre 2026"
  // Hacemos el " de " antes del año opcional con (?:\s+de(?:l)?)?
  const matchEs = cleanStr.match(/(?:[a-záéíóúñ]+\s+)?(\d{1,2})\s+de\s+([a-z]+)(?:\s+de(?:l)?)?\s+(\d{4})/);
  if (matchEs) {
    const [_, dayStr, monthStr, yearStr] = matchEs;
    
    // Usar startsWith para tolerar errores tipográficos (ej: 'novimienbre' -> 'novi')
    let month = '';
    if (monthStr.startsWith('ener')) month = '01';
    else if (monthStr.startsWith('febr')) month = '02';
    else if (monthStr.startsWith('marz')) month = '03';
    else if (monthStr.startsWith('abri')) month = '04';
    else if (monthStr.startsWith('may')) month = '05';
    else if (monthStr.startsWith('juni')) month = '06';
    else if (monthStr.startsWith('juli')) month = '07';
    else if (monthStr.startsWith('agos')) month = '08';
    else if (monthStr.startsWith('sept') || monthStr.startsWith('set')) month = '09';
    else if (monthStr.startsWith('octu')) month = '10';
    else if (monthStr.startsWith('novi')) month = '11';
    else if (monthStr.startsWith('dici')) month = '12';

    if (month) {
      return `${yearStr}-${month}-${dayStr.padStart(2, '0')}T00:00:00Z`;
    }
  }
  
  // Match DD/MM/YYYY or DD-MM-YYYY
  const matchSlash = cleanStr.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})$/);
  if (matchSlash) {
    const [_, d, m, y] = matchSlash;
    return `${y}-${m.padStart(2, '0')}-${d.padStart(2, '0')}T00:00:00Z`;
  }
  
  // Try standard parsing if it's already an ISO or valid standard date format
  const parsed = Date.parse(dateStr);
  if (!isNaN(parsed)) {
    return new Date(parsed).toISOString();
  }

  return dateStr;
};

const schema = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": name,
  "description": cleanValue(description),
  "startDate": formatSchemaDate(startDate),
  "endDate": formatSchemaDate(endDate),
  "url": cleanValue(url),
  "image": cleanValue(image),
  "eventStatus": `https://schema.org/${status}`,
  "eventAttendanceMode": `https://schema.org/${attendanceMode}`,
  "location": (locationName || locationAddress) ? {
    "@type": "Place",
    "name": cleanValue(locationName),
    "address": locationAddress ? {
      "@type": "PostalAddress",
      "streetAddress": cleanValue(locationAddress)
    } : undefined
  } : undefined,
  "organizer": organizerName ? (
    Array.isArray(organizerName) 
      ? organizerName.map(org => ({ "@type": "Organization", "name": cleanValue(org) }))
      : { "@type": "Organization", "name": cleanValue(organizerName) }
  ) : undefined,
  "offers": offersUrl ? {
    "@type": "Offer",
    "url": cleanValue(offersUrl),
    "availability": "https://schema.org/InStock"
  } : undefined,
  "performer": performers.length > 0 ? performers.map(p => ({
    "@type": p.type,
    "name": p.name
  })) : undefined
};

// Remove undefined keys
const finalSchema = Object.fromEntries(
  Object.entries(schema).filter(([_, v]) => v !== undefined)
);
---

<script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />
