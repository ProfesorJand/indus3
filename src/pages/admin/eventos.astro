---
import MainLayout from "@layouts/MainLayout.astro";
import HeaderSticky from "@components/headers/HeaderSticky.astro";
import FooterThreeCols from "@components/footers/FooterThreeCols.astro";
import Section from "@components/base/Section.astro";
import Container from "@components/base/Container.astro";
import EventsForm from "@components/forms/events.astro";

const seoTitle = "Gestión de Eventos | Indus3 Admin";
---

<MainLayout title={seoTitle}>
  <script is:inline slot="seo">
    if (sessionStorage.getItem('indus3_admin_session') !== 'true') {
      window.location.replace('/admin');
    }
  </script>
  <HeaderSticky slot="header" />

  <main>
    <Section variant="alt">
      <Container >
        <EventsForm />
      </Container>
    </Section>
  </main>

  <FooterThreeCols slot="footer" />
</MainLayout>
