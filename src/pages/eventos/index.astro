---
import MainLayout from "@layouts/MainLayout.astro";
import SEO from "@components/seo/SEO.astro";
import HeaderSticky from "@components/headers/HeaderSticky.astro";
import FooterThreeCols from "@components/footers/FooterThreeCols.astro";
import Section from "@components/base/Section.astro";
import Container from "@components/base/Container.astro";
import BodyGrid from "@components/body/BodyGrid.astro";
import fs from "node:fs";
import path from "node:path";
import LogoCard from "@components/logo/LogoCard.astro";
import { getEventos } from "@stores/eventos";


const eventsData = await getEventos();

const seoTitle = "Eventos | Indus3";
const seoDesc =
  "Próximos eventos, conciertos y festivales producidos por Indus3.";
const projectRoot = process.cwd();
const clientesDir = path.resolve(projectRoot, "public/eventos-pasados");
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

let files: string[] = [];
try {
  files = fs.readdirSync(clientesDir);
  if (files.length === 0)
    console.warn("Warning: No files found in", clientesDir);
} catch (error) {
  console.error("Error reading clients directory 3:", error);
}
const eventosPasados = files
  .filter((file) => /\.(webp|png|jpg|jpeg|svg)$/i.test(file))
  .map((file) => {
    const nameWithoutExt = file.replace(/\.[^/.]+$/, "");
    // Remove "Logo-" prefix and replace hyphens with spaces
    const title = nameWithoutExt.replace(/^Logo-/i, "").replace(/-/g, " ");

    return {
      image: `${baseUrl}/eventos-pasados/${file}`,
      title: title,
      link: "/#",
    };
  });

const clientesDir2 = path.resolve(projectRoot, "public/eventos-pasados/eventos-mas-antiguos");
let files2: string[] = [];
try {
  files2 = fs.readdirSync(clientesDir2);
  if (files2.length === 0)
    console.warn("Warning: No files found in", clientesDir);
} catch (error) {
  console.error("Error reading clients directory 3:", error);
}
const eventosPasados2 = files2
  .filter((file) => /\.(webp|png|jpg|jpeg|svg)$/i.test(file))
  .map((file) => {
    const nameWithoutExt = file.replace(/\.[^/.]+$/, "");
    // Remove "Logo-" prefix and replace hyphens with spaces
    const title = nameWithoutExt.replace(/^Logo-/i, "").replace(/-/g, " ");

    return {
      image: `${baseUrl}/eventos-pasados/eventos-mas-antiguos/${file}`,
      title: title,
      link: "/#",
    };
  });


const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<MainLayout title={seoTitle} canonical={canonicalURL}>
  <SEO slot="seo" title={seoTitle} description={seoDesc} />

  <HeaderSticky slot="header" />

  <Section variant="hero">
    <Container variant="mid" flexDirection="column">
      <h1
        style="text-align: center; font-size: var(--font-size-4xl); margin-bottom: var(--space-4);"
      >
        Cartelera de Eventos
      </h1>
      <p
        style="text-align: center; color: var(--color-text-light); max-width: 600px; margin: 0 auto;margin-bottom: var(--space-4);"
      >
        Descubre las próximas experiencias que tenemos preparadas para ti.
      </p>

      {
        eventsData.length > 0 ? (
          <BodyGrid
            columns={eventsData.length > 2 ? 2 : eventsData.length}
            tablet={eventsData.length > 2 ? 2 : eventsData.length}
            mobile={1}
            justifyContent="center"
          >
            {eventsData.map((event) => (
              <a href={`${base}eventos/${event.id}`} class="event-card">
                <div class="image-wrapper">
                  <img src={event.imagenPR} alt={event.nombreEvento} />
                </div>
                <div class="content">
                  <h3>{event.nombreEvento}</h3>
                  <p class="location">
                    <i class="fas fa-map-marker-alt" /> {event.lugarEvento}
                  </p>
                  <div class="date-badge">{event.fechaEvento}</div>
                  <span class="btn-more">Más Información</span>
                </div>
              </a>
            ))}
          </BodyGrid>
        ) : (
          <div style="text-align: center;justify-content: center;display: flex;flex-direction: column;align-items: center;">
            <h3>No hay eventos programados en este momento.</h3>
            <p>
              Vuelve pronto para enterarte de nuestras próximas producciones.
            </p>
          </div>
        )
      }
    </Container>
  </Section>
  <Section paddingTop="0">
    <Container variant="mid" flexDirection="column">
      <div class="hero-content">
      <h2>Eventos Pasados</h2>
      <p>Descubre los eventos que hemos realizado en el pasado.</p>
      {
        eventosPasados.length > 0 ? (
          <BodyGrid columns={3} mobile={2} >
            {eventosPasados.map((event) => (
              <img src={event.image} alt={event.title} class="past-event-img" />
            ))}
            {eventosPasados2.map((event) => (
              <img src={event.image} alt={event.title} class="past-event-img" />
            ))}
          </BodyGrid>
        ) : (
          <div style="text-align: center;justify-content: center;display: flex;flex-direction: column;align-items: center;">
            <h3>No hay eventos programados en este momento.</h3>
            <p>
              Vuelve pronto para enterarte de nuestras próximas producciones.
            </p>
          </div>
        )
      }
      </div>
    </Container>
  </Section>
  <FooterThreeCols slot="footer" />

  <!-- Modal para ver imágenes grandes -->
  <div id="image-modal" class="modal">
    <img id="modal-img" class="modal-content" src="" alt="Evento Pasado" />
  </div>
</MainLayout>

<script>
  const modal = document.getElementById("image-modal");
  const modalImg = (document.getElementById("modal-img") as HTMLImageElement);
  const pastEvents = document.querySelectorAll(".past-event-img");

  pastEvents.forEach(img => {
    img.addEventListener("click", () => {
      if (modal && modalImg) {
        modal.style.display = "flex";
        modalImg.src = (img as HTMLImageElement).src;
        document.body.style.overflow = "hidden"; // Desactivar scroll al abrir
      }
    });
  });

  if (modal) {
    modal.addEventListener("click", () => {
      modal.style.display = "none";
      document.body.style.overflow = "auto"; // Reactivar scroll al cerrar
    });
  }
</script>

<style>
  .hero-content{
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
  }
  .event-card {
    background: var(--color-bg);
    border-radius: var(--border-radius-xl);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-border);
    transition: all 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .event-card:hover {
    transform: translateY(-10px);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-xl);
  }
  .image-wrapper {
    position: relative;
    height: 200px;
    overflow: hidden;
  }
  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .event-card:hover .image-wrapper img {
    transform: scale(1.1);
  }
  .date-badge {
    position: relative;
    background: var(--color-primary);
    color: white;
    padding: 0.4rem 0.8rem;
    border-radius: var(--border-radius-md);
    font-size: 0.8rem;
    font-weight: 700;
    width: fit-content;
    margin-bottom: 1rem;
  }
  .content {
    padding: 1.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }
  .content h3 {
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
  }
  .location {
    font-size: 0.9rem;
    color: var(--color-primary-light);
    margin-bottom: 1rem;
  }
  .description {
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }
  .btn-more {
    margin-top: auto;
    color: var(--color-primary);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .btn-more::after {
    content: "→";
    transition: transform 0.3s ease;
  }
  .event-card:hover .btn-more::after {
    transform: translateX(5px);
  }

  /* Estilos para Eventos Pasados y Modal */
  .past-event-img {
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border-radius: var(--border-radius-lg);
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }
 
  .past-event-img:hover {
    transform: scale(1.02);
    box-shadow: var(--shadow-lg);
  }

  .modal {
    display: none;
    position: fixed;
    z-index: 2000; /* Por encima del header sticky */
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.95);
    justify-content: center;
    align-items: center;
    cursor: pointer;
    backdrop-filter: blur(5px);
  }

  .modal-content {
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
    border-radius: var(--border-radius-md);
    box-shadow: 0 0 30px rgba(0, 0, 0, 0.5);
    animation: zoom 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes zoom {
    from {
      transform: scale(0.8);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>
