---
import MainLayout from "@layouts/MainLayout.astro";
import SEO from "@components/seo/SEO.astro";
import { websiteSchema, organizationSchema } from "@utils/seo";
import PrestamosServiciosDe from "@components/banners/servicios/PrestamosServiciosDe.astro";

// Repositorio de Componentes (Mix & Match)
import HeaderSticky from "@components/headers/HeaderSticky.astro";
// import HeaderTransparent from "@components/headers/HeaderTransparent.astro";
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';



import BodyTwoColumns from "@components/body/BodyTwoColumns.astro";
import BodyGrid from "@components/body/BodyGrid.astro";
import CardCarousel from "@components/base/CardCarousel.astro";

import FooterThreeCols from "@components/footers/FooterThreeCols.astro";
// import FooterSimple from "@components/footers/FooterSimple.astro";

// Base Components
import Section from "@components/base/Section.astro";
import Button from "@components/base/Button.astro";
import LogoCard from "@components/logo/LogoCard.astro";
import Container from "@components/base/Container.astro";
import Slider from "@components/base/Slider.astro";
import CardArtista from "@components/base/CardArtista.astro";
import artistas from "../data/artistas.json";
import { getEventos } from "@stores/eventos";
import { getBiografias } from "@stores/biografias";
import { getSliders } from "@stores/slider";

const seoTitle = "Inicio";
const seoDesc = "Sistema de plantillas modular y escalable para creación rápida de sitios web corporativos y landing pages.";


const cards = [
  {
    id: 1,
    image: "https://api.indus3pro.com/eventos/banners/lgaplay.webp",
    title: "Road to VGS 2026",
    description: "El evento más importante de la industria de los videojuegos",
    primaryButtonText: "Más detalles",
    ventaEntradas: "/eventos/road-to-vgs",
    actions: [
      {
        label: "Más detalles",
        url: "/guias/consejos-para-ir-a-conciertos/",
        variant: "primary" as const
      }
    ]
  },
  {
    id: 2,
    image: "https://api.indus3pro.com/eventos/imagenes/pr-dante-gebel---presidente-world-tour-despedida.webp",
    title: "Presidante World Tour Despedida 2026",
    description: "El pastor y conferencista internacional Dante Gebel regresa a Venezuela con su más reciente producción",
    primaryButtonText: "Más detalles",
    ventaEntradas: "/eventos/dante/",
    actions: [
      {
        label: "Más detalles",
        url: "/eventos/dante/",
        variant: "primary" as const
      }
    ]
  },
  {
    id: 3,
    image: "https://indus3pro.com/img/guias/conciertos.webp",
    title: "Guía de Conciertos 2026",
    description: "Descubre que debes de tener en cuenta a la hora de asistir a un concierto",
    primaryButtonText: "Más detalles",
    ventaEntradas: "/guias/consejos-para-ir-a-conciertos/",
  },
  {
    id: 4,
    image: "https://indus3pro.com/img/guias/placeholder-guide.png",
    title: "Top 50 Artistas Venezolanos en Spotify",
    description: "Descubre los artistas venezolanos más populares en Spotify",
    primaryButtonText: "Más detalles",
    ventaEntradas: "/top-spotify/artistas-venezolanos/",
  },
  {
    id: 5,
    image: "https://indus3pro.com/img/guias/placeholder-guide.png",
    title: "Top 50 Canciones Global en Spotify",
    description: "Descubre las canciones más populares en Spotify a nivel mundial",
    primaryButtonText: "Más detalles",
    ventaEntradas: "/top-spotify/canciones-globales/",
  }
];

const allEventsHome = await getEventos();
const pastEventTitlesHome = allEventsHome
  .filter(e => e.esPasado)
  .map(e => (e.nombreEvento || '').toLowerCase().trim());

const backendSliders = await getSliders();
let finalCards = backendSliders && backendSliders.length > 0 ? backendSliders : cards;

finalCards = finalCards.filter(c => {
  if (c.status === 'draft') return false;
  const slideTitle = (c.title || '').toLowerCase().trim();
  if (pastEventTitlesHome.includes(slideTitle)) return false;
  return true;
});

finalCards = finalCards.sort((a, b) => {
  const orderA = parseInt(a.order) || 0;
  const orderB = parseInt(b.order) || 0;
  return orderA - orderB;
});

const projectRoot = process.cwd();
const clientesDir = path.resolve(projectRoot, 'public/clientes');
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

let files: string[] = [];
try {
  files = fs.readdirSync(clientesDir);
  if (files.length === 0) console.warn('Warning: No files found in', clientesDir);
} catch (error) {
  console.error('Error reading clients directory 3:', error);
}
const clientes = files
  .filter(file => /\.(webp|png|jpg|jpeg|svg)$/i.test(file))
  .map(file => {
    const nameWithoutExt = file.replace(/\.[^/.]+$/, "");
    // Remove "Logo-" prefix and replace hyphens with spaces
    const title = nameWithoutExt
      .replace(/^Logo-/i, "")
      .replace(/-/g, " ");

    return {
      image: `${baseUrl}/clientes/${file}`,
      title: title,
      link: "/#"
    };
  }
)

const base = import.meta.env.BASE_URL;

const eventsData = allEventsHome.filter(e => e.status !== 'draft' && e.id !== '__indus3_past_events_order__' && !e.esPasado);
const recentEvents = eventsData.slice(0, 3);

const biografiasData = (await getBiografias()).filter(b => b.status !== 'draft');
const recentBios = biografiasData.slice(0, 5);

const eventosPasadosDir = path.resolve(projectRoot, "public/eventos-pasados");
let eventosPasadosFiles: string[] = [];
try {
  const allFiles = fs.readdirSync(eventosPasadosDir);
  eventosPasadosFiles = allFiles.filter(file => fs.statSync(path.join(eventosPasadosDir, file)).isFile());
} catch (error) {
  console.error("Error reading eventos-pasados directory:", error);
}

const apiPastEventsHome = allEventsHome
  .filter(e => e.status !== 'draft' && e.id !== '__indus3_past_events_order__' && e.esPasado)
  .map(e => ({
    id: String(e.id),
    image: e.flyerEvento || e.imagenPR || e.imagenBanner,
    title: e.nombreEvento,
  }));

const staticPastEventsHome = eventosPasadosFiles
  .filter((file) => /\.(webp|png|jpg|jpeg|svg)$/i.test(file))
  .map((file) => {
    const nameWithoutExt = file.replace(/\.[^/.]+$/, "");
    const title = nameWithoutExt.replace(/-/g, " ");

    return {
      id: `pasado-${file}`,
      image: `${baseUrl}/eventos-pasados/${file}`,
      title: title,
    };
  });

const pastOrderObj = allEventsHome.find(e => e.id === '__indus3_past_events_order__');
const pastOrderList = pastOrderObj?.orderList || [];
const pastOrderMap = new Map();
pastOrderList.forEach((id, idx) => pastOrderMap.set(String(id), idx));

const combinedPastEventsHome = [...apiPastEventsHome, ...staticPastEventsHome];
const sortedPastEventsHome = combinedPastEventsHome.sort((a, b) => {
  const indexA = pastOrderMap.has(String(a.id)) ? pastOrderMap.get(String(a.id)) : -1;
  const indexB = pastOrderMap.has(String(b.id)) ? pastOrderMap.get(String(b.id)) : -1;
  if (indexA !== -1 && indexB !== -1) return indexA - indexB;
  if (indexA !== -1) return -1;
  if (indexB !== -1) return 1;
  return 0;
});

const eventosPasados = sortedPastEventsHome.slice(0, 4);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<MainLayout title={seoTitle} canonical={canonicalURL}>
  <SEO 
    slot="seo" 
    title={seoTitle} 
    description={seoDesc} 
    schemas={[websiteSchema, organizationSchema]} 
  />
  {finalCards.length > 0 && (
    <link slot="seo" rel="preload" as="image" href={finalCards[0].image} fetchpriority="high" />
  )}

  <HeaderSticky slot="header" />

  <Section variant="fullHeightWithHeader">
    <Container fullHeight={true} justifyContent="center">
      <Slider slides={finalCards} height="100%" heightMobile="100%"/>
    </Container>
  </Section>

  <Section>
    <Container variant="mid" flexDirection="column" alignItems="center" justifyContent="center">
      <h2 style="text-align: center; margin-bottom: var(--space-4); font-size: var(--font-size-3xl);">
        Indus3 Entertainment Group
      </h2>
      <p style="text-align: center; margin-bottom: var(--space-4); font-size: var(--font-size-xl);">
        Somos una agencia de producción de eventos y booking de artistas líder en la industria del entretenimiento. Ofrecemos soluciones integrales 360° en producción técnica, gestión de talento y comunicación estratégica, conectando marcas con audiencias a través de ejecuciones de alto impacto en Venezuela y Latinoamérica.
      </p>

    </Container>
  </Section>

  <!-- <Section>
    <Container flexDirection="column">
      <PrestamosServiciosDe link={`${base}servicios`}/>
    </Container>
  </Section> -->

  <!-- Artistas Section (Versión Marquee Infinito) -->
  <Section>
    <Container flexDirection="column" variant="mid">
      <h2 style="text-align: center; margin-bottom: var(--space-4); font-size: var(--font-size-3xl);">Booking agency</h2>
      <p style="text-align: center; margin-bottom: var(--space-4); font-size: var(--font-size-xl);">En Indus3pro, no solo producimos eventos, también representamos talento a través de nuestra agencia de booking. Conectamos a los mejores artistas con escenarios alrededor del mundo, gestionando cada detalle para ofrecer espectáculos inolvidables.</p>
      <div class="marquee-container">
        <div class="marquee-track">
          {artistas.map((artista) => (
            <div class="marquee-item">
              <CardArtista name={artista.name} image={artista.image} />
            </div>
          ))}
          {/* Duplicamos los elementos para crear la ilusión de bucle infinito */}
          {artistas.map((artista) => (
            <div class="marquee-item" aria-hidden="true">
              <CardArtista name={artista.name} image={artista.image} />
            </div>
          ))}
        </div>
      </div>
      <a style="align-self: center;" href={`${base}contacto`} class="btn-more">Contratar talento</a>
    </Container>
  </Section>

  <!-- Eventos Recientes -->
  {recentEvents.length > 0 && (
    <Section>
      <Container variant="mid" flexDirection="column">
        <h2 style="text-align: center; margin-bottom: var(--space-4); font-size: var(--font-size-3xl);">Próximos Eventos</h2>
        <BodyGrid
          columns={recentEvents.length > 3 ? 3 : recentEvents.length}
          tablet={recentEvents.length > 2 ? 2 : recentEvents.length}
          mobile={1}
          justifyContent="center"
        >
          {recentEvents.map((event) => (
            <a href={`${base}eventos/${event.id}`} class="event-card">
              <div class="image-wrapper">
                <img src={event.imagenPR} alt={event.nombreEvento} />
              </div>
              <div class="content">
                <h3>{event.nombreEvento}</h3>
                <p class="location">
                  <i class="fas fa-map-marker-alt" /> {event.lugarEvento}
                </p>
                <div class="date-badge">{event.fechaEvento}</div>
                {
                  event?.descripcionEvento?.length > 0 && (
                    <p class="description">
                      {event.descripcionEvento?.substring(0, 100)}...
                    </p>
                  )
                }
                <span class="btn-more">Más Información</span>
              </div>
            </a>
          ))}
        </BodyGrid>
      </Container>
    </Section>
  )}

  <!-- Eventos Pasados -->
  {eventosPasados.length > 0 && (
    <Section>
      <Container variant="mid" flexDirection="column">
        <h2 style="text-align: center; margin-bottom: var(--space-4); font-size: var(--font-size-3xl);">El archivo de eventos Indus3</h2>
        <p style="text-align: center; margin-bottom: var(--space-4);">Nuestra historia escrita en escenarios. Explora las producciones propias y colaboraciones estratégicas que forman parte del ecosistema de entretenimiento de Indus3 Entertainment Group.</p>
        <BodyGrid mobile={2} columns={4} tablet={2} justifyContent="center" >
          {eventosPasados.map((event) => (
            <img src={event.image} alt={event.title} class="past-event-img" />
          ))}
        </BodyGrid>
        <a style="align-self: center; margin-top: var(--space-4);" href={`${base}eventos`} class="btn-more">Ver todos los eventos</a>
      </Container>
    </Section>
  )}

  <!-- Biografías Recientes -->
  {recentBios.length > 0 && (
    <Section>
      <Container variant="mid" flexDirection="column">
        <h2 style="text-align: center; margin-bottom: var(--space-4); font-size: var(--font-size-3xl);">Directorio de Perfiles y Trayectorias</h2>
        <p style="text-align: center; margin-bottom: var(--space-4);">Una mirada profunda al ADN del entretenimiento. Exploramos la historia y el impacto de los artistas que forman parte de nuestra red global, ofreciendo un archivo exhaustivo para marcas, fans y profesionales de la industria.</p>
        <BodyGrid 
          mobile={2}
          columns={recentBios.length >= 5 ? 5 : recentBios.length} 
          justifyContent="center" 
          alignItems="stretch" 
          fullWidth={true}
        >
          {recentBios.map((bio) => (
            <div class="bio-card-wrapper">
              <a href={`${base}biografias/${bio.id}`} class="bio-link">
                <img src={bio.squareImg} alt={bio.name} class="bio-square" />
                <span class="bio-name">{bio.name}</span>
              </a>
            </div>
          ))}
        </BodyGrid>
        <a style="align-self: center; margin-top: var(--space-4);" href={`${base}biografias`} class="btn-more">Ver más perfiles</a>
      </Container>
    </Section>
  )}

  <!-- Artistas Section -->
  <!-- <Section>
    <Container flexDirection="column">
      <h2 style="text-align: center; margin-bottom: var(--space-12); font-size: var(--font-size-3xl);">Nuestros Clientes y Aliados</h2>
      <div class="artist-grid">
        {artistas.map((artista) => (
          <CardArtista name={artista.name} image={artista.image} />
        ))}
      </div>
      
    </Container>
  </Section> -->

  <Section >
        
      <h2 style="text-align: center;margin-bottom: var(--space-4);justify-self:center;font-size: var(--font-size-3xl)">Experiencia profesional de nuestro equipo</h2>
      <p style="margin-bottom: var(--space-4);text-align: center;">Miembros de nuestro equipo han participado en proyectos relacionados con estas marcas a lo largo de su trayectoria profesional, incluyendo experiencias previas a Indus3.</p>
      <BodyGrid mobile={2} columns={4} justifyContent="center" alignItems="center" >
        {
          clientes.map((cliente) => (
            <LogoCard 
              title={cliente.title}
              image={cliente.image}
            />
          ))
        }
      </BodyGrid>
  </Section>

  <FooterThreeCols slot="footer" />
</MainLayout>


<style>
    .event-card {
      background: var(--color-bg);
      border-radius: var(--border-radius-xl);
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      border: 1px solid var(--color-border);
      transition: all 0.3s ease;
      height: 100%;
      display: flex;
      flex-direction: column;
      width: 100%;
    }
    .event-card:hover {
      transform: translateY(-10px);
      border-color: var(--color-primary);
      box-shadow: var(--shadow-xl);
    }
    .image-wrapper {
      position: relative;
      height: 200px;
      overflow: hidden;
    }
    .image-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }
    .event-card:hover .image-wrapper img {
      transform: scale(1.1);
    }
    .date-badge {
      position: relative;
      background: var(--color-primary);
      color: white;
      padding: 0.4rem 0.8rem;
      border-radius: var(--border-radius-md);
      font-size: 0.8rem;
      font-weight: 700;
      margin-bottom: 1rem;
      width: fit-content;
    }
    .content {
      padding: 1.5rem;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }
    .content h3 {
      font-size: 1.4rem;
      margin-bottom: 0.5rem;
    }
    .location {
      font-size: 0.9rem;
      color: var(--color-primary-light);
      margin-bottom: 1rem;
    }
    .description {
      font-size: 0.9rem;
      color: var(--color-text-light);
      margin-bottom: 1.5rem;
      line-height: 1.6;
    }
    .btn-more {
      margin-top: auto;
      color: var(--color-primary);
      font-weight: 700;
      text-transform: uppercase;
      font-size: 0.8rem;
      letter-spacing: 1px;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .btn-more::after {
      content: "→";
      transition: transform 0.3s ease;
    }
    .event-card:hover .btn-more::after {
      transform: translateX(5px);
    }

    .bio-card-wrapper {
      position: relative;
      transition: transform 0.3s ease;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      height: 100%;
      width: 100%;
    }
  
    .bio-card-wrapper:hover {
      transform: translateY(-8px);
    }
  
    .bio-link {
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      height: 100%;
    }
  
    .bio-square {
      border-radius: var(--border-radius-lg);
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      display: block;
      margin-bottom: var(--space-2);
    }
  
    .bio-name {
      font-weight: 600;
      text-align: center;
    }

    .past-event-img {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      border-radius: var(--border-radius-lg);
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      display: block;
    }
   
    .past-event-img:hover {
      transform: scale(1.02);
      box-shadow: var(--shadow-lg);
    }

    .marquee-container {
      overflow: hidden;
      width: 100%;
      position: relative;
      display: flex;
      align-items: center;
      padding: var(--space-4) 0;
      -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
      mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    }

    .marquee-track {
      display: flex;
      width: max-content;
      animation: scroll-marquee 40s linear infinite;
    }

    .marquee-track:hover {
      animation-play-state: paused;
    }

    .marquee-item {
      flex: 0 0 auto;
      width: 150px;
      margin-right: var(--space-8);
    }

    @keyframes scroll-marquee {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(-50%);
      }
    }

    .artist-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .artist-grid > :global(*) {
      flex: 0 0 calc(12.5% - var(--space-8));
      min-width: 120px;
    }

    @media (max-width: 1400px) {
      .artist-grid > :global(*) {
        flex: 0 0 calc(16.66% - var(--space-8));
      }
    }

    @media (max-width: 1024px) {
      .artist-grid > :global(*) {
        flex: 0 0 calc(25% - var(--space-8));
      }
    }

    @media (max-width: 640px) {
      .artist-grid {
        gap: var(--space-4);
      }
      .artist-grid > :global(*) {
        flex: 0 0 calc(50% - var(--space-4));
      }
    }
  </style>

