---
import MainLayout from "@layouts/MainLayout.astro";
import SEO from "@components/seo/SEO.astro";
import { websiteSchema, organizationSchema } from "@utils/seo";
import HeaderSticky from "@components/headers/HeaderSticky.astro";
import FooterThreeCols from "@components/footers/FooterThreeCols.astro";
import Section from "@components/base/Section.astro";
import Container from "@components/base/Container.astro";
import BodyGrid from "@components/body/BodyGrid.astro";
import PrestamosServiciosDe from "@components/banners/servicios/PrestamosServiciosDe.astro";
import artistas from "@data/artistas.json";
import Card from "@components/base/Card.astro";
import CardArtista from "@components/base/CardArtista.astro";

const seoTitle = "Nuestros Servicios";
const seoDesc = "Agencia 360 de comunicaciones, marketing y producción de eventos. Booking, conciertos, festivales y mucho más.";

const serviceCategories = [
  {
    title: "Corporativo",
    icon: "fas fa-briefcase",
    items: [
      "Eventos (lanzamientos, ruedas de prensa, fiestas)",
      "Promociones en PDV",
      "Actividades BTL",
      "Convenciones de ventas"
    ]
  },
  {
    title: "Musicales",
    icon: "fas fa-music",
    items: [
      "Conciertos",
      "Festivales",
      "Giras nacionales e internacionales",
      "Booking artistas (nacionales e internacionales)"
    ]
  },
  {
    title: "Entretenimiento",
    icon: "fas fa-smile-beam",
    items: [
      "Exposiciones",
      "Charlas y conferencias",
      "Deporte",
      "Esports",
      "Circos y shows temáticos"
    ]
  }
];

const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<MainLayout title={seoTitle} canonical={canonicalURL}>
  <SEO 
    slot="seo" 
    title={seoTitle} 
    description={seoDesc} 
    schemas={[websiteSchema, organizationSchema]} 
  />

  <HeaderSticky slot="header" />

  <main>
    <!-- Hero Section -->
    <Section className="services-hero">
      <Container flexDirection="column" variant="mid">
        <div class="container">
          <h1 class="text-center">Nuestros Servicios</h1>
          <p class="text-center">
            Somos los arquitectos de la emoción, transformando ideas en experiencias que trascienden.
          </p>
          
          <!-- <PrestamosServiciosDe/> -->
           <div class="container-2">
             <h2>Experiencias de Entretenimiento:</h2>
             <p>Líderes en la creación de espacios para exposiciones , deporte, Esports y shows de alto impacto.<br>
               <a href={`${base}eventos`} >
                 Ver eventos
                </a>
              </p>
              <div class="container-3">
              <ul>
                  <li>
                    <span class="li-icon"></span>
                    Exposiciones
                  </li>
                  <li>
                    <span class="li-icon"></span>
                    Charlas y conferencias
                  </li>
                  <li>
                    <span class="li-icon"></span>
                    Deporte
                  </li>
                  <li>
                    <span class="li-icon"></span>
                    Esports
                  </li>
                  <li>
                    <span class="li-icon"></span>
                    Circos y shows temáticos
                  </li>
              </ul>
            </div>


            </div>
            <div class="container-2">
              <h2>Producción Corporativa:</h2>
              <p>
                Lanzamientos, Promociones y convenciones con enfoque en retorno de inversión. 
              </p>
              <div class="container-3">
                <ul>
                    <li>
                      <span class="li-icon"></span>
                      Eventos (lanzamientos, ruedas de prensa, fiestas)
                    </li>
                    <li>
                      <span class="li-icon"></span>
                      Promociones en PDV
                    </li>
                    <li>
                      <span class="li-icon"></span>
                      Actividades BTL
                    </li>
                    <li>
                      <span class="li-icon"></span>
                       Convenciones de ventas
                    </li>

                </ul>
              </div>
             
            </div>
            <div class="container-2">
              <h2>Giras Musicales & Booking:</h2>
              <p>
                Producción general de conciertos y gestión de talento. 
              </p>
              <div class="container-3">
                <ul>
                    <li>
                      <span class="li-icon"></span>
                      Conciertos
                    </li>
                    <li>
                      <span class="li-icon"></span>
                      Festivales
                    </li>
                    <li>
                      <span class="li-icon"></span>
                      Giras nacionales e internacionales
                    </li>
                    <li>
                      <span class="li-icon"></span>
                      Booking artistas (nacionales e internacionales)
                    </li>

                </ul>
              </div>
            </div>
            <div class="artist-grid">
              {artistas.map((artista) => (
                <CardArtista name={artista.name} image={artista.image} />
              ))}
            </div>
              
        </div>
      </Container>
    </Section>

    <!-- Closing Statement -->
    <Section>
      <Container>
        <div class="container-degradado">
          <i class="fas fa-quote-left" style="font-size: 3rem; opacity: 0.2; margin-bottom: var(--space-4);"></i>
          <h2 style="font-size: var(--font-size-2xl); line-height: 1.4; font-weight: 500;">
            Te ofrecemos una <strong>solución integral</strong> para tu presencia de marca, con una producción profesional y con la experiencia necesaria para optimizar efectividad, tiempo y recursos.
          </h2>
          <div style="margin-top: var(--space-8);" class="btn">
            <a href={`${base}contacto`} style="display: inline-block; padding: var(--space-4) var(--space-10); text-decoration: none; border-radius: var(--border-radius-full); font-weight: 700; transition: all 0.3s ease;">
              Contáctanos hoy
            </a>
          </div>
        </div>
      </Container>
    </Section>
  </main>

  <FooterThreeCols slot="footer" />
</MainLayout>

<style>
  .container{
    display: flex; 
    flex-direction: column;
    gap: var(--space-4);
  }
  .container-2{
    display: flex; 
    flex-direction: column;
    width: 100%;
    height: 100%;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .container-3{
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  ul{
    list-style: none; 
    padding: 0; 
    display: flex; 
    flex-direction: column; 
    gap: var(--space-3);
  }
  li{

    display: flex; 
    align-items: center; 
    gap: var(--space-2);
  }
  li span.li-icon{
    width: 6px; 
    height: 6px; 
    background: var(--color-primary); 
    border-radius: 50%;
  }
  .text-center{
    text-align: center; 
  }
  .service-category-card:hover {
    transform: translateY(-8px);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-lg);
  }
  .btn {
    display: flex;
    justify-content: center;
    align-items: center;
    transition: all 0.3s ease;
  }

  .btn > a{
    background: var(--color-primary);
    color: white;
  }
  
  .btn:hover > a{
    background: white;
    color: var(--color-primary);
    border-color: var(--color-primary);
    transform: translateY(-4px);
  }
  .container-degradado{
    text-align: center; 
    max-width: 900px; 
    margin: 0 auto; 
    padding: var(--space-12) var(--space-6); 
    background: linear-gradient(90deg, var(--color-bg-alt) 0%, var(--color-bg-alt) 100%); 
    border-radius: var(--border-radius-2xl);
    box-shadow: var(--shadow-xl);
  }

  .artist-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: var(--space-4);
  margin: var(--space-4) 0;
}

  :global(html.dark) .container-degradado {
    background: linear-gradient(90deg, var(--color-bg-alt) 0%, var(--color-bg) 100%); 
  }

</style>
