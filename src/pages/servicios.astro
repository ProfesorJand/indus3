---
import MainLayout from "@layouts/MainLayout.astro";
import SEO from "@components/seo/SEO.astro";
import { websiteSchema, organizationSchema } from "@utils/seo";
import HeaderSticky from "@components/headers/HeaderSticky.astro";
import FooterThreeCols from "@components/footers/FooterThreeCols.astro";
import Section from "@components/base/Section.astro";
import Container from "@components/base/Container.astro";
import BodyGrid from "@components/body/BodyGrid.astro";
import PrestamosServiciosDe from "@components/banners/servicios/PrestamosServiciosDe.astro";
import artistas from "@data/artistas.json";
import Card from "@components/base/Card.astro";
import CardArtista from "@components/base/CardArtista.astro";

const seoTitle = "Nuestros Servicios";
const seoDesc = "Agencia 360 de comunicaciones, marketing y producción de eventos. Booking, conciertos, festivales y mucho más.";

const serviceCategories = [
  {
    title: "Corporativo",
    icon: "fas fa-briefcase",
    items: [
      "Eventos (lanzamientos, ruedas de prensa, fiestas)",
      "Promociones en PDV",
      "Actividades BTL",
      "Convenciones de ventas"
    ]
  },
  {
    title: "Musicales",
    icon: "fas fa-music",
    items: [
      "Conciertos",
      "Festivales",
      "Giras nacionales e internacionales",
      "Booking artistas (nacionales e internacionales)"
    ]
  },
  {
    title: "Entretenimiento",
    icon: "fas fa-smile-beam",
    items: [
      "Exposiciones",
      "Charlas y conferencias",
      "Deporte",
      "Esports",
      "Circos y shows temáticos"
    ]
  }
];

const base = import.meta.env.BASE_URL;
---

<MainLayout title={seoTitle}>
  <SEO 
    slot="seo" 
    title={seoTitle} 
    description={seoDesc} 
    schemas={[websiteSchema, organizationSchema]} 
  />

  <HeaderSticky slot="header" />

  <main>
    <!-- Hero Section -->
    <Section className="services-hero">
      <Container flexDirection="column">
        <div class="container">
          <h1 class="text-center">Nuestros Servicios</h1>
          <p class="text-center">
            Somos los arquitectos de la emoción, transformando ideas en experiencias que trascienden.
          </p>
          
          <!-- <PrestamosServiciosDe/> -->
           <h2>Experiencias de Entretenimiento:</h2>
            <p>Líderes en la creación de espacios para exposiciones , deporte, Esports y shows de alto impacto (circos y temáticos) 
              <a href={`${base}eventos`} >
                Ver eventos
              </a>
            </p>
            <h2>Booking & Giras Musicales:</h2>
            <p>
              Gestión de talento nacional e internacional y producción general de conciertos y festivales. 
            </p>
            <div class="artist-grid">
              {artistas.map((artista) => (
                <CardArtista name={artista.name} image={artista.image} />
              ))}
            </div>
            <h2>Producción Corporativa:</h2>
            <p>
              Lanzamientos (evento, rueda de presna, fiestas), Promociones en punto PDV y BTL y convenciones con enfoque de ventas en retorno de inversión. 
            </p>
              
        </div>
      </Container>
    </Section>

    <!-- Detailed Services Grid -->
    <Section variant="alt">
      <Container flexDirection="column">
        <h2 style="text-align: center; margin-bottom: var(--space-12); font-size: var(--font-size-3xl);">Especialidades por Área</h2>
        <BodyGrid columns={3} justifyContent="center" alignItems="center">
          {serviceCategories.map(category => (
            <div style="background: var(--color-bg); padding: var(--space-8); border-radius: var(--border-radius-lg); border: 1px solid var(--color-border); transition: transform 0.3s ease; height: 100%;" class="service-category-card">
              <div style="width: 60px; height: 60px; justify-self:center; background: var(--color-primary-light); color: var(--color-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-2); font-size: 1.5rem;">
                <i class={category.icon}></i>
              </div>
              <h3 style="justify-self:center; font-size: var(--font-size-2xl); margin-bottom: var(--space-4);">{category.title}</h3>
              <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-3);">
                {category.items.map(item => (
                  <li style="color: var(--color-text-light); display: flex; align-items: center; gap: var(--space-2);">
                    <span style="width: 6px; height: 6px; background: var(--color-primary); border-radius: 50%;"></span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </BodyGrid>
      </Container>
    </Section>

    <!-- Closing Statement -->
    <Section>
      <Container>
        <div class="container-degradado">
          <i class="fas fa-quote-left" style="font-size: 3rem; opacity: 0.2; margin-bottom: var(--space-4);"></i>
          <h2 style="font-size: var(--font-size-2xl); line-height: 1.4; font-weight: 500;">
            Te ofrecemos una <strong>solución integral</strong> para tu presencia de marca, con una producción profesional y con la experiencia necesaria para optimizar efectividad, tiempo y recursos.
          </h2>
          <div style="margin-top: var(--space-8);" class="btn">
            <a href={`${base}contacto`} style="display: inline-block; padding: var(--space-4) var(--space-10); text-decoration: none; border-radius: var(--border-radius-full); font-weight: 700; transition: all 0.3s ease;">
              Contáctanos hoy
            </a>
          </div>
        </div>
      </Container>
    </Section>
  </main>

  <FooterThreeCols slot="footer" />
</MainLayout>

<style>
  .container{
    display: flex; 
    flex-direction: column;
    gap: var(--space-4);
  }
  .text-center{
    text-align: center; 
  }
  .service-category-card:hover {
    transform: translateY(-8px);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-lg);
  }
  .btn {
    display: flex;
    justify-content: center;
    align-items: center;
    transition: all 0.3s ease;
  }

  .btn > a{
    background: var(--color-primary);
    color: white;
  }
  
  .btn:hover > a{
    background: white;
    color: var(--color-primary);
    border-color: var(--color-primary);
    transform: translateY(-4px);
  }
  .container-degradado{
    text-align: center; 
    max-width: 900px; 
    margin: 0 auto; 
    padding: var(--space-12) var(--space-6); 
    background: linear-gradient(90deg, var(--color-bg-alt) 0%, var(--color-bg-alt) 100%); 
    border-radius: var(--border-radius-2xl);
    box-shadow: var(--shadow-xl);
  }

  .artist-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: var(--space-4);
  margin: var(--space-4) 0;
}

  :global(html.dark) .container-degradado {
    background: linear-gradient(90deg, var(--color-bg-alt) 0%, var(--color-bg) 100%); 
  }

</style>
