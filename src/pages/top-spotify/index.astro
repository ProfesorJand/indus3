---
import MainLayout from "@layouts/MainLayout.astro";
import HeaderSticky from "@components/headers/HeaderSticky.astro";
import FooterThreeCols from "@components/footers/FooterThreeCols.astro";
import Section from "@components/base/Section.astro";
import Container from "@components/base/Container.astro";
import BodyGrid from "@components/body/BodyGrid.astro";
import LogoCard from "@components/logo/LogoCard.astro";

import artistasData from "../../../spotify-data-new2.json";
import cancionesData from "../../../spotify-top-50-songs-global.json";

const cards = [
  {
    id:1,
    title: "Top 50 Artistas Venezolanos",
    image: "/img/guias/placeholder-guide.png",
    images: artistasData.slice(0, 3).map((a: any) => a.artistImage.filter((artista: any) => artista?.name === a.name)[0]?.img || a.backgroundArtistImage),
    href: "top-spotify/artistas-venezolanos",
    description: "Ranking de los artistas venezolanos más escuchados en Spotify."
  },
  {
    id:2,
    title: "Top 50 Canciones Globales",
    image: "/img/guias/placeholder-guide.png",
    images: cancionesData.slice(0, 3).map((c: any) => c.image),
    href: "top-spotify/canciones-globales",
    description: "Los hits más populares en todo el mundo hoy mismo."
  },
]

const base = import.meta.env.BASE_URL;
const year= new Date().getFullYear();
---

<MainLayout title="Biografías y Perfiles">
  <HeaderSticky slot="header" />
    <Section>
      <Container flexDirection="column" variant="mid">
        <div class="bio-intro">
          <h1>Top Spotify {year}</h1>
          <p>
            Sincronizamos diariamente con Spotify para traerte los rankings oficiales de los artistas y canciones que están rompiendo récords en Venezuela y el mundo.
          </p>
        </div>

        <BodyGrid columns={cards.length > 3 ? 3 : cards.length}>
            {cards.map(card => (
              <a href={`${base}${card.href}`} class="event-card">
                <div class="image-wrapper">
                  <img src={card.image} alt={card.title} class="main-img" />
                  <div class="avatars-overlay">
                    {card.images.map((img: string) => (
                      <img src={img} alt="Top 3" class="avatar" />
                    ))}
                  </div>
                </div>
                <div class="content">
                  <h3>{card.title}</h3>
                  <p class="description">{card.description?.substring(0, 100)}...</p>
                  <span class="btn-more">Más Información</span>
                </div>
              </a>
            ))}
          </BodyGrid>
      </Container>
    </Section>
  <FooterThreeCols slot="footer" />
</MainLayout>

<style>
  .bio-intro{
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap:var(--space-4);
    margin-bottom: var(--space-4);
  }
  .event-card {
    background: var(--color-bg);
    border-radius: var(--border-radius-xl);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-border);
    transition: all 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .event-card:hover {
    transform: translateY(-10px);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-xl);
  }
  .image-wrapper {
    position: relative;
    height: 200px;
    overflow: hidden;
  }
  .image-wrapper .main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .event-card:hover .image-wrapper .main-img {
    transform: scale(1.1);
  }
  .avatars-overlay {
    position: absolute;
    bottom: var(--space-2);
    right: var(--space-2);
    display: flex;
    z-index: 2;
  }
  .avatars-overlay .avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 2px solid var(--color-bg);
    object-fit: cover;
    margin-left: -15px;
    transition: transform 0.3s ease;
  }
  .avatars-overlay .avatar:first-child {
    margin-left: 0;
  }
  .avatars-overlay .avatar:hover {
    transform: translateY(-5px);
    z-index: 10;
  }
  .date-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--color-primary);
    color: white;
    padding: 0.4rem 0.8rem;
    border-radius: var(--border-radius-md);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .content {
    padding: 1.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }
  .content h3 {
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
  }
  .location {
    font-size: 0.9rem;
    color: var(--color-primary-light);
    margin-bottom: 1rem;
  }
  .description {
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }
  .btn-more {
    margin-top: auto;
    color: var(--color-primary);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .btn-more::after {
    content: "→";
    transition: transform 0.3s ease;
  }
  .event-card:hover .btn-more::after {
    transform: translateX(5px);
  }
</style>
